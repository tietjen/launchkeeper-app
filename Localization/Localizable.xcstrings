    },
    "Erledigte entfernen — nimmt alle erfolgreich ausgeführten und abgehakten Einträge aus der Liste; offene, abgelehnte und fehlgeschlagene bleiben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigte entfernen — nimmt alle erfolgreich ausgeführten und abgehakten Einträge aus der Liste; offene, abgelehnte und fehlgeschlagene bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove done — takes all successfully run and ticked-off entries off the list; open, refused and failed ones stay."
          }
        }
      }
    },
    "Erst der Plan, dann die Ausführung": {
      "localizations": {
        "de": {
