    "%@ — legt %lld von %lld markierten Einträgen in die Warteschlange (nur die, zu denen diese Aktion passt). Ausgeführt wird erst dort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — legt %lld von %lld markierten Einträgen in die Warteschlange (nur die, zu denen diese Aktion passt). Ausgeführt wird erst dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — adds %lld of %lld marked entries to the queue (only those this action fits). They run only from there."
          }
        }
      }
    },
    "%@ — zeigt im Terminal erst den Plan; ausgeführt wird erst mit --apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — zeigt im Terminal erst den Plan; ausgeführt wird erst mit --apply."
