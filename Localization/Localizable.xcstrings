        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First the plan, then the run"
          }
        }
      }
    },
    "Es läuft noch Version %@ des Hilfsprogramms, diese App bringt %@ mit. Nach dem Neustart kannst du ausführen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft noch Version %@ des Hilfsprogramms, diese App bringt %@ mit. Nach dem Neustart kannst du ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper version %@ is still running; this app ships %@. After a restart you can run the action."
          }
        }
      }
    },
    "Es läuft noch eine ältere Version des Hilfsprogramms (%@). Bis zum Neustart führt LaunchKeeper darüber nichts aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft noch eine ältere Version des Hilfsprogramms (%@). Bis zum Neustart führt LaunchKeeper darüber nichts aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older version of the helper is still running (%@). LaunchKeeper runs nothing through it until it restarts."
          }
        }
      }
    },
    "Es nimmt keine Befehle entgegen, nur „was mit welchem Eintrag“, prüft selbst und nimmt nur Verbindungen der echten, signierten LaunchKeeper-App an.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es nimmt keine Befehle entgegen, nur „was mit welchem Eintrag“, prüft selbst und nimmt nur Verbindungen der echten, signierten LaunchKeeper-App an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It doesn't accept commands, only “what with which entry”, checks things itself, and accepts connections only from the real, signed LaunchKeeper app."
          }
        }
      }
    },
    "Etwas ist auffällig, z. B. ein Skript-Interpreter als Programm. Die Detailspalte sagt, was.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist auffällig, z. B. ein Skript-Interpreter als Programm. Die Detailspalte sagt, was."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something stands out, e.g. a script interpreter as the program. The detail column says what."
          }
        }
      }
    },
