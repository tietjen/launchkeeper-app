    "Ohne dein Zutun ändert LaunchKeeper nichts. Jede Änderung zeigt vorher ihren Plan, lässt sich rückgängig machen und wird danach geprüft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dein Zutun ändert LaunchKeeper nichts. Jede Änderung zeigt vorher ihren Plan, lässt sich rückgängig machen und wird danach geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LaunchKeeper changes nothing without you. Every change shows its plan first, can be undone, and is checked afterward."
          }
        }
      }
    },
