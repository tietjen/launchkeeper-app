    "Leeren — nichts wird ausgeführt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren — nichts wird ausgeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear — nothing runs"
          }
        }
      }
    },
    "Leeren — nimmt alle Einträge aus der Warteschlange (mit Rückfrage). Ausgeführtes bleibt ausgeführt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren — nimmt alle Einträge aus der Warteschlange (mit Rückfrage). Ausgeführtes bleibt ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear — removes all entries from the queue (asks first). What has run stays done."
          }
        }
      }
    },
    "Legt den SHA-256 von %@ in die Zwischenablage — auf virustotal.com in die Suche einfügen. Die Datei selbst verlässt den Mac nicht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den SHA-256 von %@ in die Zwischenablage — auf virustotal.com in die Suche einfügen. Die Datei selbst verlässt den Mac nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the SHA-256 of %@ to the clipboard — paste it into the search on virustotal.com. The file itself never leaves the Mac."
          }
        }
      }
    },
    "Legt für alles, was in dieser Sitzung erledigt wurde, den Weg zurück in die Warteschlange.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt für alles, was in dieser Sitzung erledigt wurde, den Weg zurück in die Warteschlange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the way back into the queue for everything done in this session."
          }
        }
      }
    },
    "Letzte Prüfung unvollständig, nicht verglichen: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Prüfung unvollständig, nicht verglichen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last check incomplete, not compared: %@"
          }
        }
      }
    },
    "Links eine Ansicht wählen, in der Mitte einen Eintrag — rechts steht, was er bedeutet. Symbole markieren, was Aufmerksamkeit verdient.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links eine Ansicht wählen, in der Mitte einen Eintrag — rechts steht, was er bedeutet. Symbole markieren, was Aufmerksamkeit verdient."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a view on the left, an entry in the middle — the right side says what it means. Icons mark what deserves attention."
          }
        }
      }
    },
    "Links steht, was LaunchKeeper kann und wie man damit arbeitet.": {
      "localizations": {
