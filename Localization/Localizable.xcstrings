          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs administrator rights"
          }
        }
      }
    },
    "Braucht Administratorrechte — nach dem Klick fragt macOS nach Touch ID oder deinem Passwort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht Administratorrechte — nach dem Klick fragt macOS nach Touch ID oder deinem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs administrator rights — after the click macOS asks for Touch ID or your password."
          }
        }
      }
    },
    "Darf im Hintergrund laufen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf im Hintergrund laufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed in the background"
          }
        }
      }
    },
    "Das Hilfsprogramm hat nichts ausgeführt — auf dem Mac ist nichts geändert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hilfsprogramm hat nichts ausgeführt — auf dem Mac ist nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper ran nothing — nothing on the Mac has changed."
          }
        }
      }
    },
    "Das Paket %@ wird in derselben Warteschlange deinstalliert — diese Aktion ist dann überflüssig.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket %@ wird in derselben Warteschlange deinstalliert — diese Aktion ist dann überflüssig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package %@ is uninstalled in the same queue — this action is then unnecessary."
          }
        }
      }
    },
    "Das erledigst du selbst an der genannten Stelle. „Jetzt prüfen“ liest alles frisch ein — auch die Schalter der Systemeinstellungen, die ⌘R aus dem Zwischenspeicher nimmt — und hakt ab, was verschwunden oder ausgeschaltet ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erledigst du selbst an der genannten Stelle. „Jetzt prüfen“ liest alles frisch ein — auch die Schalter der Systemeinstellungen, die ⌘R aus dem Zwischenspeicher nimmt — und hakt ab, was verschwunden oder ausgeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You take care of these yourself at the place named. “Check now” reads everything afresh — including the System Settings switches that ⌘R takes from the cache — and ticks off what is gone or switched off."
          }
        }
      }
    },
    "Das würde passieren — noch ist nichts geändert:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das würde passieren — noch ist nichts geändert:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This would happen — nothing has changed yet:"
          }
        }
      }
    },
    "Dateien": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien"
          }
        },
        "en": {
