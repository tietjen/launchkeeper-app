    "Freigaben widerrufen: Systemeinstellungen › Datenschutz & Sicherheit, dort in der passenden Rubrik (z. B. Bedienungshilfen, Festplattenvollzugriff) den Schalter ausschalten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigaben widerrufen: Systemeinstellungen › Datenschutz & Sicherheit, dort in der passenden Rubrik (z. B. Bedienungshilfen, Festplattenvollzugriff) den Schalter ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke access: System Settings › Privacy & Security, switch it off in the matching section (e.g. Accessibility, Full Disk Access)."
