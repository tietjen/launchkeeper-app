            "value": "Continue"
          }
        }
      }
    },
    "Wie in den Systemeinstellungen unter Anmeldeobjekte & Erweiterungen: welche App was im Hintergrund darf — und ob der Schalter von macOS oder eine launchd-Einstellung ihn abschaltet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie in den Systemeinstellungen unter Anmeldeobjekte & Erweiterungen: welche App was im Hintergrund darf — und ob der Schalter von macOS oder eine launchd-Einstellung ihn abschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like in System Settings under Login Items & Extensions: which app is allowed to do what in the background — and whether the switch is turned off by macOS or by a launchd setting."
          }
        }
      }
    },
