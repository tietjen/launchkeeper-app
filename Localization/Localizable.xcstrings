    "Mindestens eine Komponente ist per launchd deaktiviert — in der Systemeinstellung unsichtbar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine Komponente ist per launchd deaktiviert — in der Systemeinstellung unsichtbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one component is disabled via launchd — invisible in System Settings"
          }
        }
      }
    },
    "Mit dem Installationsprogramm installierte Pakete und ihre Dateien. Hier lässt sich ein Paket vollständig deinstallieren oder nur sein Beleg entfernen, wenn die Dateien längst fehlen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Installationsprogramm installierte Pakete und ihre Dateien. Hier lässt sich ein Paket vollständig deinstallieren oder nur sein Beleg entfernen, wenn die Dateien längst fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages installed with the Installer app, and their files. Here you can uninstall a package completely, or just remove its receipt if the files are long gone."
          }
        }
      }
    },
