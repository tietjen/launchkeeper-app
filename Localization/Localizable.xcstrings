    "Markierung aufheben — entfernt die Häkchen in dieser Ansicht. Einträge, die schon in der Warteschlange stehen, bleiben dort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierung aufheben — entfernt die Häkchen in dieser Ansicht. Einträge, die schon in der Warteschlange stehen, bleiben dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear marks — removes the ticks in this view. Entries already in the queue stay there."
          }
        }
      }
    },
    "Meist hilft ein Neustart des Hilfsprogramms. Danach wird der Plan neu berechnet und du kannst es noch einmal versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist hilft ein Neustart des Hilfsprogramms. Danach wird der Plan neu berechnet und du kannst es noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarting the helper usually helps. The plan is then computed again and you can try once more."
          }
        }
      }
    },
    "Menüleiste und Anmeldung": {
      "localizations": {
        "de": {
