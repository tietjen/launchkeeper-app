    "Nimmt nur Dateien, die noch unverändert vom Paket stammen, und verschiebt sie in die Quarantäne — wiederherstellbar. Veränderte und geteilte Dateien bleiben.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt nur Dateien, die noch unverändert vom Paket stammen, und verschiebt sie in die Quarantäne — wiederherstellbar. Veränderte und geteilte Dateien bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes only files still unchanged from the package and moves them into the quarantine — restorable. Modified and shared files stay."
          }
        }
      }
    },
