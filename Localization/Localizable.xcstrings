    "Updates werden vor der Installation gegen LaunchKeepers Signaturschlüssel geprüft. Das Hilfsprogramm kommt mit dem Update und startet nach einer Minute Leerlauf in der neuen Version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates werden vor der Installation gegen LaunchKeepers Signaturschlüssel geprüft. Das Hilfsprogramm kommt mit dem Update und startet nach einer Minute Leerlauf in der neuen Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are checked against LaunchKeeper's signing key before installation. The helper comes with the update and restarts in the new version after a minute of idle time."
          }
        }
      }
    },
